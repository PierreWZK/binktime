{% extends 'base.html.twig' %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "BinkTime",
  "url": "https://binktime.projectp.fr/",
  "description": "Gestionnaire de tournois de poker : inscriptions, structure des blindes, horloge plein écran, éliminations, recaves, calcul des gains et classement de saison.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "Web",
  "inLanguage": "fr",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "image": "https://binktime.projectp.fr/og.png",
  "author": {
    "@type": "Person",
    "name": "PierreWZK",
    "url": "https://github.com/PierreWZK"
  },
  "isPartOf": {
    "@type": "WebSite",
    "name": "ProjectP",
    "url": "https://projectp.fr/"
  }
}
</script>
{% endblock %}

{% block body %}
    {# Héros : accroche à gauche, aperçu de l'horloge qui tourne à droite #}
    <section class="hero">
        <div class="wrap hero__grid">
            <div class="hero__text reveal">
                <p class="kicker label label--or">Jour 17 · 30 jours, 30 projets</p>
                <h1 class="h1">Vos tournois de poker, <span class="chute">réglés comme une horloge.</span></h1>
                <p class="lead">Inscriptions, structure des blindes, horloge plein écran, éliminations, recaves et calcul des gains. BinkTime tient aussi le classement de toute la saison.</p>
                <div class="actions">
                    <a class="btn btn--or" href="{{ path('tournament_new') }}">Créer un tournoi <span aria-hidden="true">→</span></a>
                    <a class="btn btn--ligne" href="{{ live ? path('clock_public', {token: live.publicToken}) : '#horloge' }}">Voir l'horloge</a>
                </div>
                <hr class="rule">
                <ul class="stack-list label">
                    <li>Symfony</li><li>Twig</li><li>MySQL</li>
                </ul>
            </div>

            <div class="card preview reveal" data-demo-clock aria-label="Aperçu de l'horloge">
                <div class="preview__top">
                    <span class="label">Aperçu · Horloge</span>
                    <span class="badge badge--point">En cours</span>
                </div>
                <p class="preview__level"><span data-clock-level>Niveau VII</span></p>
                <p class="preview__time num" data-clock-time>18:42</p>
                <p class="label preview__caption">Temps restant</p>
                <div class="progress"><span data-clock-progress style="width:7%"></span></div>
                <dl class="preview__grid">
                    <div class="data"><dt class="label">Blindes</dt><dd class="data__value num" data-clock-blinds>400 / 800</dd></div>
                    <div class="data"><dt class="label">Prochain niveau</dt><dd class="data__value num" data-clock-next>500 / 1 000</dd></div>
                    <div class="data"><dt class="label">Joueurs</dt><dd class="data__value num">7 / 12</dd></div>
                    <div class="data"><dt class="label">Pause dans</dt><dd class="data__value" data-clock-break>2 niveaux</dd></div>
                </dl>
            </div>
        </div>
    </section>

    {# Bandeau des étapes de la soirée #}
    <div class="band" aria-hidden="true">
        <div class="band__track">
            {% for i in 1..2 %}
                {% for step in ['Inscriptions', 'Blindes', 'Horloge', 'Recaves & add-ons', 'Gains', 'Saison'] %}
                    <span>{{ step }}</span><i class="losange"></i>
                {% endfor %}
            {% endfor %}
        </div>
    </div>

    <section class="section" id="programme">
        <div class="wrap">
            <div class="split-head reveal">
                <div>
                    <p class="kicker label label--or">Au programme</p>
                    <h2 class="h2">Toute la soirée, <span class="chute">du premier jeton au dernier tapis.</span></h2>
                </div>
                <p class="split-head__aside">Vous jouez. BinkTime s'occupe du reste : chronomètre, comptes et palmarès.</p>
            </div>

            <ol class="program reveal">
                {% for step in [
                    {title: 'Créer le tournoi', text: 'Buy-in, tapis de départ et structure des blindes, avec des modèles fournis.'},
                    {title: 'Inscrire les joueurs', text: 'Les arrivées, les recaves et les add-ons, suivis sans calepin.'},
                    {title: 'L\'horloge', text: 'Plein écran : niveau, blindes, temps restant, prochain niveau et pause.'},
                    {title: 'Éliminations & gains', text: 'Les sorties dans l\'ordre, les places payées et les gains calculés pour vous.'},
                    {title: 'La saison', text: 'Un classement qui se construit soir après soir, en points par place.'},
                ] %}
                    <li class="program__item">
                        <span class="roman program__num">{{ loop.index|roman }}</span>
                        <h3 class="program__title">{{ step.title }}</h3>
                        <p>{{ step.text }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    <section class="section section--ebene" id="horloge">
        <div class="wrap two-col">
            <div class="reveal">
                <p class="kicker label label--or">L'horloge</p>
                <h2 class="h2">Le temps, <span class="chute">tenu avec élégance.</span></h2>
                <p class="lead two-col__lead">Projetée sur la télévision du salon, l'horloge annonce chaque montée de blindes. Personne ne surveille sa montre, tout le monde voit la même chose.</p>
                <ul class="feature-list">
                    <li><span>Niveau en cours</span><em>en grand</em></li>
                    <li><span>Blindes &amp; ante</span><em>lisibles de loin</em></li>
                    <li><span>Prochain niveau</span><em>annoncé</em></li>
                    <li><span>Pause</span><em>d'un geste</em></li>
                </ul>
            </div>

            <div class="card structure reveal">
                <div class="card__head">
                    <h3 class="h3 card__title">Structure des blindes</h3>
                    <span class="label">Modèle · exemple</span>
                </div>
                <div class="table-scroll">
                    <table class="table">
                        <thead><tr><th>Niveau</th><th>Petite</th><th>Grosse</th><th>Ante</th><th>Durée</th></tr></thead>
                        <tbody>
                            {% for level in levels %}
                                {% if level.break %}
                                    <tr class="is-break"><td colspan="5">Pause · {{ level.minutes }} min</td></tr>
                                {% else %}
                                    {% set n = level.tournament.levelNumber(level) %}
                                    <tr{% if n == 7 %} class="is-active"{% endif %}>
                                        <td>{{ n|roman }}{% if n == 7 %} · en cours{% endif %}</td>
                                        <td>{{ level.smallBlind|chips }}</td>
                                        <td>{{ level.bigBlind|chips }}</td>
                                        <td>{{ level.ante|chips }}</td>
                                        <td>{{ level.minutes }} min</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="saison">
        <div class="wrap">
            <div class="reveal">
                <p class="kicker label label--or">Gains &amp; saison</p>
                <h2 class="h2">Chaque élimination compte. <span class="chute">Chaque place aussi.</span></h2>
            </div>

            <div class="duo">
                <div class="card reveal">
                    <div class="card__head">
                        <h3 class="h3 card__title">Places payées</h3>
                        <span class="label">Exemple · 12 joueurs × 20 €</span>
                    </div>
                    <ol class="podium">
                        {% for prize in prizes %}
                            <li>
                                <span class="podium__place">{{ loop.index }}<sup>{{ loop.first ? 'er' : 'e' }}</sup></span>
                                <span class="label">{{ [50, 30, 20][loop.index0] }} %</span>
                                <span class="podium__prize num">{{ prize }} €</span>
                            </li>
                        {% endfor %}
                    </ol>
                    <p class="note">Recaves et add-ons intégrés au prize pool, sans calcul de tête en fin de soirée.</p>
                </div>

                <div class="card reveal">
                    <div class="card__head">
                        <h3 class="h3 card__title">Classement de la saison</h3>
                        {% if season %}
                            <a class="label label--or" href="{{ path('organizer_show', {slug: season.organizer.slug}) }}">{{ season.organizer.name }} →</a>
                        {% else %}
                            <span class="label">Points par place</span>
                        {% endif %}
                    </div>
                    <ol class="ranking">
                        {% for row in standings %}
                            <li>
                                <span class="roman ranking__rank">{{ '%02d'|format(loop.index) }}</span>
                                <span class="ranking__name">{{ row.name }}</span>
                                <span class="ranking__meta">{{ row.tournaments }} tournoi{{ row.tournaments > 1 ? 's' }}</span>
                                <span class="ranking__pts num">{{ row.points }} <small>pts</small></span>
                            </li>
                        {% else %}
                            <li class="ranking__empty">Le classement s'écrit au premier tournoi terminé.</li>
                        {% endfor %}
                    </ol>
                    {% if season %}<p class="note">{{ season.name }} · joueurs − place + 1, doublés dans l'argent.</p>{% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="section section--ebene" id="installer">
        <div class="wrap two-col two-col--center">
            <div class="reveal">
                <p class="kicker label label--or">Lancer en local</p>
                <h2 class="h2">Cinq commandes, <span class="chute">et la table est mise.</span></h2>
                <p class="two-col__lead">SQLite en local, aucune base à installer. En production, identifiants MySQL dans <code>.env.local</code>, jamais versionné.</p>
            </div>
            <div class="terminal reveal">
                <div class="terminal__bar"><i></i><i></i><i></i><span class="label">Terminal</span></div>
                <pre><code><span>$</span> git clone https://github.com/PierreWZK/binktime.git
<span>$</span> composer install
<span>$</span> php bin/console doctrine:migrations:migrate
<span>$</span> php bin/console doctrine:fixtures:load
<span>$</span> symfony serve -d   <em># http://127.0.0.1:8000</em></code></pre>
            </div>
        </div>
    </section>

    <section class="section finale">
        <div class="wrap reveal">
            <span class="finale__mark">{% include '_logo.html.twig' %}</span>
            <h2 class="h2">Shuffle up <span class="chute">and deal.</span></h2>
            <p>Mise en ligne prévue sur <a class="link" href="https://binktime.projectp.fr">binktime.projectp.fr</a>.</p>
            <a class="btn btn--or" href="{{ path('tournament_new') }}">Créer un tournoi</a>
        </div>
    </section>
{% endblock %}
