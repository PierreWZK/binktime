<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}BinkTime · Vos tournois de poker, réglés comme une horloge{% endblock %}</title>
        <meta name="description" content="{% block description %}Inscriptions, structure des blindes, horloge plein écran, éliminations, recaves et calcul des gains. BinkTime tient aussi le classement de la saison.{% endblock %}">
        <meta name="theme-color" content="#0A0A0B">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        {# Aperçu du lien partagé (Open Graph, Twitter) #}
        <meta property="og:type" content="website">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:site_name" content="BinkTime">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:image" content="{{ absolute_url('/og.png') }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="BinkTime, l'horloge de vos tournois de poker, en noir et or">
        <meta name="twitter:card" content="summary_large_image">
        {# Pages privées (adresse à jeton, espace) : bloc vidé, elles ont un noindex à la place #}
        {% block canonical %}
            {% set route = app.request.attributes.get('_route') %}
            {% if route %}
                {% set canonical = url(route, app.request.attributes.get('_route_params')) %}
                <link rel="canonical" href="{{ canonical }}">
                <meta property="og:url" content="{{ canonical }}">
            {% endif %}
        {% endblock %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Manrope:wght@400;500;600&display=swap">
        {% block head %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block header %}
            <header class="site-header">
                <div class="wrap">
                    <a class="logo" href="{{ path('home') }}" aria-label="BinkTime, accueil">{% include '_logo.html.twig' %}BinkTime</a>
                    <nav class="nav" aria-label="Navigation principale">
                        <a href="{{ path('home') }}#programme">Programme</a>
                        <a href="{{ path('home') }}#horloge">L'horloge</a>
                        <a href="{{ path('home') }}#saison">Saison</a>
                        <a href="{{ path('organizer_index') }}">Établissements</a>
                        <a href="{{ path('game_daily') }}">Jeu du jour</a>
                    </nav>
                    <div class="header-actions">
                        {% if app.user %}
                            <a class="badge badge--link" href="{{ path('organizer_dashboard') }}">Mon espace</a>
                        {% else %}
                            <a class="badge badge--link" href="{{ path('app_login') }}">Connexion</a>
                        {% endif %}
                        <a class="btn btn--or btn--sm" href="{{ path('tournament_new') }}">Créer un tournoi</a>
                        <details class="menu">
                            <summary aria-label="Menu"><span></span></summary>
                            <nav aria-label="Navigation mobile">
                                <a href="{{ path('home') }}#programme">Programme</a>
                                <a href="{{ path('home') }}#horloge">L'horloge</a>
                                <a href="{{ path('home') }}#saison">Saison</a>
                                <a href="{{ path('organizer_index') }}">Établissements</a>
                                <a href="{{ path('game_daily') }}">Jeu du jour</a>
                                <a href="{{ app.user ? path('organizer_dashboard') : path('app_login') }}">{{ app.user ? 'Mon espace' : 'Connexion' }}</a>
                                <a class="menu__cta" href="{{ path('tournament_new') }}">Créer un tournoi</a>
                            </nav>
                        </details>
                    </div>
                </div>
            </header>
        {% endblock %}

        <main>{% block body %}{% endblock %}</main>

        {% block footer %}
            <footer class="site-footer">
                <div class="wrap">
                    <span class="logo">{% include '_logo.html.twig' %}BinkTime <small>Symfony · Twig · MySQL</small></span>
                    <a class="label label--or" href="https://projectp.fr/">Jour 17 · 30 jours, 30 projets</a>
                </div>
            </footer>
        {% endblock %}
    </body>
</html>
